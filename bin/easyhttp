#!/bin/bash
if [ "$1" = "--update" ]; then
  if [ "$EUID" -ne 0 ]; then
    echo "run as root"
    exit 1
  fi
  set -e
  echo "Updating EasyHTTP..."
  cd /usr/share/easyhttp
  git fetch origin
  git reset --hard origin/main
  chmod 755 /usr/share/easyhttp/main.py
  install -m 755 /usr/share/easyhttp/bin/easyhttp /usr/local/bin/easyhttp
  echo "Update done."
  exit 0
fi
python3 /usr/share/easyhttp/main.py "$@"